# Cloudflare account that will be billed for Workers AI calls
CLOUDFLARE_ACCOUNT_ID=
# API token with the "Workers AI: Read" + "Workers AI: Edit" permissions
CLOUDFLARE_API_TOKEN=

CLEF_TIMEOUT_S=90
# Image bytes count against Clef's 65k-token context; keep images small
CLEF_MAX_IMAGE_BYTES=60000

# Dashboard default: spectrogram | plots | features | plots+features+guide
DASHBOARD_VARIANT=plots+features+guide
MAX_CONCURRENT_CLEF=4

# Alternative to the API token: route Clef calls through the Worker in worker/
# (local: `cd worker && npx wrangler dev` -> http://localhost:8787)
CLEF_WORKER_URL=
CLEF_WORKER_TOKEN=

